# N8N Webhook Endpoints
# Copy this file to .env and replace with your actual webhook URLs

# CRM interface language: en, fr, or ar
VITE_APP_LOCALE=en

# Leads management webhook (CRUD operations)
VITE_WEBHOOK_LEADS=https://n8n.systemifyautomation.com/webhook/reactivationflow-leads

# Chatbot webhook
VITE_WEBHOOK_CHATBOT=https://n8n.systemifyautomation.com/webhook/reactivationflow-chatbot

# Authentication webhook
VITE_WEBHOOK_LOGIN=https://n8n.systemifyautomation.com/webhook/reactivationflow-new-user-login

# Availability check webhook
VITE_WEBHOOK_CHECK_AVAILABILITY=https://n8n.systemifyautomation.com/webhook/reactivationflow-check-availability

# Meeting management webhooks
VITE_WEBHOOK_CANCEL_MEETING=https://n8n.systemifyautomation.com/webhook/reactivationflow-cancel-meeting
VITE_WEBHOOK_RESCHEDULE_MEETING=https://n8n.systemifyautomation.com/webhook/reactivationflow-lead-reschedule
VITE_WEBHOOK_RESCHEDULED_CONFIRMATION=https://n8n.systemifyautomation.com/webhook/reactivationflow-lead-rescheduled

# Users management webhook
VITE_WEBHOOK_USERS=https://n8n.systemifyautomation.com/webhook/reactivationflow-users
