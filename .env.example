# N8N Webhook Endpoints
# Copy this file to .env and replace with your actual webhook URLs

# CRM interface language: en, fr, or ar
VITE_APP_LOCALE=en

# Clinic identity displayed below the ReactivationFlow sidebar brand
VITE_CLINIC_NAME=Your Clinic
VITE_CLINIC_LOGO_URL=/clinic-logo.png

# Leads management webhook (CRUD operations)
VITE_WEBHOOK_LEADS=https://automation.example.com/webhook/crm-leads

# Chatbot webhook
VITE_WEBHOOK_CHATBOT=https://automation.example.com/webhook/chatbot

# Authentication webhook
VITE_WEBHOOK_LOGIN=https://automation.example.com/webhook/user-login

# Availability check webhook
VITE_WEBHOOK_CHECK_AVAILABILITY=https://automation.example.com/webhook/check-availability

# Meeting management webhooks
VITE_WEBHOOK_CANCEL_MEETING=https://automation.example.com/webhook/cancel-meeting
VITE_WEBHOOK_RESCHEDULE_MEETING=https://automation.example.com/webhook/reschedule-meeting
VITE_WEBHOOK_RESCHEDULED_CONFIRMATION=https://automation.example.com/webhook/rescheduled-confirmation

# Users management webhook
VITE_WEBHOOK_USERS=https://automation.example.com/webhook/users

# Support tickets webhook
VITE_WEBHOOK_SUPPORT_TICKETS=https://automation.example.com/webhook/support-tickets

# Support ticket messages webhook
VITE_WEBHOOK_SUPPORT_MESSAGES=https://automation.example.com/webhook/support-ticket-messages
